[".config/nvim"]
    type = "git-repo"
    url = "git@github.com:josh-allan/nvim.git"
    refreshPeriod = "168h"
    [".config/nvim".pull]
        args = ["--ff-only"]

["src/go-git"]
    type = "git-repo"
    url = "git@github.com:josh-allan/go-git"
    refreshPeriod = "168h"
    ["src/go-git".pull]
        args = ["--ff-only"]

# Catppuccin Mocha ports, pinned to a commit so an apply never changes them silently.
[".config/bat/themes/Catppuccin Mocha.tmTheme"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/bat/6810349b28055dce54076712fc05fc68da4b8ec0/themes/Catppuccin%20Mocha.tmTheme"

[".config/btop/themes/catppuccin_mocha.theme"]
