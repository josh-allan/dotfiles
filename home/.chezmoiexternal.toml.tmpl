    url = "https://raw.githubusercontent.com/catppuccin/btop/f437574b600f1c6d932627050b15ff5153b58fa3/themes/catppuccin_mocha.theme"

[".config/lazygit/catppuccin-mocha-blue.yml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/lazygit/1a4b26cbc2b5be05cc5494d0d7f764120a2cf86d/themes-mergable/mocha/blue.yml"

[".config/eza/theme.yml"]
