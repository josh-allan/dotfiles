{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# (Re)loads the done-chime launch agent when it or its watcher changes. Hashes:
# agent   {{ includeTemplate "Library/LaunchAgents/com.josh.rex-done-chime.plist.tmpl" . | sha256sum }}
# watcher {{ include "dot_config/rex/done-chime.lua" | sha256sum }}
set -euo pipefail

label=com.josh.rex-done-chime
plist="$HOME/Library/LaunchAgents/$label.plist"
service="gui/$(id -u)/$label"

if [[ ! -f "$plist" ]]; then
	echo "rex: done chime skipped; Rex is not installed" >&2
	exit 0
fi
if launchctl print "$service" >/dev/null 2>&1; then
	launchctl bootout "$service"
	# bootout returns before launchd releases the label; bootstrap fails until it does.
	for _ in {1..50}; do
		launchctl print "$service" >/dev/null 2>&1 || break
		sleep 0.1
	done
fi
launchctl bootstrap "gui/$(id -u)" "$plist"
{{- end }}
