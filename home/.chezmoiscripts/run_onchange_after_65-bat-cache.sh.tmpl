#!/usr/bin/env bash
# bat (and delta through it) only sees themes after its cache is rebuilt. Reruns when the
# theme data or the shared TextMate template changes:
# {{ .theme | toJson | sha256sum }} {{ include ".chezmoitemplates/tmTheme.tmpl" | sha256sum }}
set -euo pipefail

if command -v bat >/dev/null 2>&1; then
	bat cache --build >/dev/null
fi
