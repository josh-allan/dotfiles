[user]
	name = {{ onepasswordRead (printf "op://%s/user/username" .opVault) }}
	email = {{ onepasswordRead (printf "op://%s/Git Email/username" .opVault) }}
	signingkey = {{ onepasswordRead (printf "op://%s/Git Signing Key/public key" .opVault) }}
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore
    editor = nvim
    pager = delta
[commit]
	gpgsign = true
[url "ssh://git@github.com"]
	insteadOf = https://github.com
[push]
  autoSetupRemote = true
[rebase]
  updateRefs = true
[difftool]
  prompt = false
  trustExitCode = true
[pull]
  ff = only
[tag]
	gpgSign = true
[submodule]
	recurse = true
[delta]
  navigate = true
  features = decorations
  line-numbers = true
  syntax-theme = Monokai Extended Bright
  dark = true
  hunk-header-decoration-style = ul
  hunk-header-style = line-number file syntax
