[user]
{{- if .gitName }}
	name = {{ .gitName }}
{{- end }}
{{- if .gitEmail }}
	email = {{ .gitEmail }}
{{- end }}
{{- if .gitSigningKey }}
	signingkey = {{ .gitSigningKey }}
{{- end }}
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore
    editor = nvim
    pager = delta
[commit]
	gpgsign = {{ ne .gitSigningKey "" }}
[url "ssh://git@github.com"]
	insteadOf = https://github.com
[push]
  autoSetupRemote = true
[rebase]
  updateRefs = true
[difftool]
  prompt = false
  trustExitCode = true
[pull]
  ff = only
[tag]
	gpgSign = {{ ne .gitSigningKey "" }}
[submodule]
	recurse = true
[delta]
  navigate = true
  features = decorations
  line-numbers = true
  syntax-theme = Monokai Extended Bright
  dark = true
  hunk-header-decoration-style = ul
  hunk-header-style = line-number file syntax
